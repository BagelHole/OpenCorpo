{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCorpo Policy",
  "type": "object",
  "required": ["version", "rules"],
  "properties": {
    "version": { "type": "string" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "match", "decision"],
        "properties": {
          "id": { "type": "string" },
          "match": { "type": "object" },
          "decision": { "type": "string", "enum": ["allow", "deny", "approve"] },
          "reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
