{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCorpo UI",
  "type": "object",
  "required": ["name", "sidebar", "pages"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "theme": {
      "type": "object",
      "properties": {
        "light": {
          "type": "object",
          "properties": {
            "bg": { "type": "string", "minLength": 1 },
            "bgElevated": { "type": "string", "minLength": 1 },
            "ink": { "type": "string", "minLength": 1 },
            "inkMuted": { "type": "string", "minLength": 1 },
            "border": { "type": "string", "minLength": 1 },
            "borderStrong": { "type": "string", "minLength": 1 },
            "accent": { "type": "string", "minLength": 1 },
            "accentHover": { "type": "string", "minLength": 1 },
            "success": { "type": "string", "minLength": 1 },
            "successBg": { "type": "string", "minLength": 1 },
            "warning": { "type": "string", "minLength": 1 },
            "warningBg": { "type": "string", "minLength": 1 },
            "danger": { "type": "string", "minLength": 1 },
            "dangerBg": { "type": "string", "minLength": 1 },
            "radius": { "type": "string", "minLength": 1 },
            "radiusSm": { "type": "string", "minLength": 1 },
            "shadow": { "type": "string", "minLength": 1 },
            "shadowLg": { "type": "string", "minLength": 1 },
            "fontSans": { "type": "string", "minLength": 1 },
            "fontMono": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "dark": {
          "type": "object",
          "properties": {
            "bg": { "type": "string", "minLength": 1 },
            "bgElevated": { "type": "string", "minLength": 1 },
            "ink": { "type": "string", "minLength": 1 },
            "inkMuted": { "type": "string", "minLength": 1 },
            "border": { "type": "string", "minLength": 1 },
            "borderStrong": { "type": "string", "minLength": 1 },
            "accent": { "type": "string", "minLength": 1 },
            "accentHover": { "type": "string", "minLength": 1 },
            "success": { "type": "string", "minLength": 1 },
            "successBg": { "type": "string", "minLength": 1 },
            "warning": { "type": "string", "minLength": 1 },
            "warningBg": { "type": "string", "minLength": 1 },
            "danger": { "type": "string", "minLength": 1 },
            "dangerBg": { "type": "string", "minLength": 1 },
            "radius": { "type": "string", "minLength": 1 },
            "radiusSm": { "type": "string", "minLength": 1 },
            "shadow": { "type": "string", "minLength": 1 },
            "shadowLg": { "type": "string", "minLength": 1 },
            "fontSans": { "type": "string", "minLength": 1 },
            "fontMono": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sidebar": {
      "type": "object",
      "required": ["collapsible", "items"],
      "properties": {
        "collapsible": { "type": "boolean" },
        "defaultCollapsed": { "type": "boolean" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "path", "pageId"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "pageId": { "type": "string", "minLength": 1 },
              "showWhen": {
                "type": "string",
                "enum": ["always", "advanced"],
                "default": "always"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["id", "kind", "builtin"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "const": "builtin" },
              "builtin": {
                "type": "string",
                "enum": ["chat", "jobs", "settings", "audit"]
              },
              "title": { "type": "string" },
              "description": { "type": "string" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "kind", "title", "blocks"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "const": "base" },
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "blocks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": ["type", "markdown"],
                      "properties": {
                        "type": { "type": "string", "const": "markdown" },
                        "markdown": { "type": "string" }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": ["type", "items"],
                      "properties": {
                        "type": { "type": "string", "const": "stats" },
                        "items": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "required": ["label", "value"],
                            "properties": {
                              "label": { "type": "string" },
                              "value": { "type": "string" },
                              "tone": {
                                "type": "string",
                                "enum": ["default", "success", "warning", "danger"]
                              }
                            },
                            "additionalProperties": false
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": ["type", "items"],
                      "properties": {
                        "type": { "type": "string", "const": "list" },
                        "title": { "type": "string" },
                        "items": {
                          "type": "array",
                          "items": { "type": "string" }
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": ["type", "text"],
                      "properties": {
                        "type": { "type": "string", "const": "note" },
                        "tone": {
                          "type": "string",
                          "enum": ["default", "success", "warning", "danger"]
                        },
                        "text": { "type": "string" }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": ["type", "rows"],
                      "properties": {
                        "type": { "type": "string", "const": "key_value" },
                        "title": { "type": "string" },
                        "rows": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": ["label", "value"],
                            "properties": {
                              "label": { "type": "string" },
                              "value": { "type": "string" }
                            },
                            "additionalProperties": false
                          }
                        }
                      },
                      "additionalProperties": false
                    }                    ,
                    {
                      "type": "object",
                      "required": ["type", "jobName"],
                      "properties": {
                        "type": { "type": "string", "const": "job_results" },
                        "jobName": { "type": "string", "minLength": 1 },
                        "title": { "type": "string" },
                        "maxItems": { "type": "integer", "minimum": 1, "maximum": 25 },
                        "emptyText": { "type": "string" },
                        "source": { "type": "string", "enum": ["auto", "output", "outputs"] }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": ["type", "jobName"],
                      "properties": {
                        "type": { "type": "string", "const": "job_table" },
                        "jobName": { "type": "string", "minLength": 1 },
                        "title": { "type": "string" },
                        "maxRows": { "type": "integer", "minimum": 1, "maximum": 50 },
                        "columns": {
                          "type": "array",
                          "items": { "type": "string", "minLength": 1 }
                        },
                        "emptyText": { "type": "string" },
                        "source": { "type": "string", "enum": ["auto", "output", "outputs"] }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": ["type", "buttons"],
                      "properties": {
                        "type": { "type": "string", "const": "actions" },
                        "title": { "type": "string" },
                        "description": { "type": "string" },
                        "buttons": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "required": ["label", "action"],
                            "properties": {
                              "label": { "type": "string", "minLength": 1 },
                              "style": {
                                "type": "string",
                                "enum": ["primary", "secondary", "outline"]
                              },
                              "action": {
                                "oneOf": [
                                  {
                                    "type": "object",
                                    "required": ["type", "jobName"],
                                    "properties": {
                                      "type": { "type": "string", "const": "run_job" },
                                      "jobName": { "type": "string", "minLength": 1 },
                                      "confirm": { "type": "string" }
                                    },
                                    "additionalProperties": false
                                  },
                                  {
                                    "type": "object",
                                    "required": ["type", "url"],
                                    "properties": {
                                      "type": { "type": "string", "const": "open_url" },
                                      "url": {
                                        "type": "string",
                                        "pattern": "^https?://"
                                      }
                                    },
                                    "additionalProperties": false
                                  }
                                ]
                              }
                            },
                            "additionalProperties": false
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": ["type", "package"],
                      "properties": {
                        "type": { "type": "string", "const": "react_widget" },
                        "title": { "type": "string" },
                        "description": { "type": "string" },
                        "package": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^(?:@[A-Za-z0-9._-]+/)?[A-Za-z0-9._-]+(?:@[A-Za-z0-9*^~<>=|.-]+)?$"
                        },
                        "exportName": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64,
                          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                        },
                        "props": { "type": "object" },
                        "height": { "type": "integer", "minimum": 200, "maximum": 1400 }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": ["type", "command"],
                      "properties": {
                        "type": { "type": "string", "const": "terminal_widget" },
                        "title": { "type": "string" },
                        "description": { "type": "string" },
                        "command": { "type": "string", "minLength": 1, "maxLength": 500 },
                        "cwd": { "type": "string", "maxLength": 500 },
                        "height": { "type": "integer", "minimum": 200, "maximum": 1400 },
                        "allowInput": { "type": "boolean" }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": ["type", "url"],
                      "properties": {
                        "type": { "type": "string", "const": "web_embed" },
                        "title": { "type": "string" },
                        "description": { "type": "string" },
                        "url": {
                          "type": "string",
                          "pattern": "^https?://"
                        },
                        "height": { "type": "integer", "minimum": 200, "maximum": 1800 }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": ["type", "html"],
                      "properties": {
                        "type": { "type": "string", "const": "html_embed" },
                        "title": { "type": "string" },
                        "description": { "type": "string" },
                        "html": { "type": "string", "minLength": 1, "maxLength": 200000 },
                        "height": { "type": "integer", "minimum": 200, "maximum": 2400 }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}


