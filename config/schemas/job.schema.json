{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCorpo Job",
  "type": "object",
  "required": ["name", "enabled"],
  "properties": {
    "name": { "type": "string" },
    "type": { "type": "string", "enum": ["declarative", "script"] },
    "enabled": { "type": "boolean" },
    "schedule": {
      "type": "object",
      "properties": {
        "cron": { "type": "string" },
        "timezone": { "type": "string" },
        "interval_seconds": { "type": "number" }
      },
      "additionalProperties": true
    },
    "capabilities_required": { "type": "array", "items": { "type": "string" } },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tool"],
        "properties": {
          "tool": { "type": "string" },
          "with": { "type": "object" }
        },
        "allOf": [
          {
            "not": {
              "type": "object",
              "required": ["tool"],
              "properties": {
                "tool": { "const": "script.run" }
              }
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "script": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": ["string", "number", "boolean"] } },
        "timeout_ms": { "type": "number", "minimum": 1000 },
        "env": { "type": "object" },
        "dependencies": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "dependency_install_timeout_ms": { "type": "number", "minimum": 1000, "maximum": 300000 }
      },
      "additionalProperties": false
    },
    "approval": { "type": "object" }
  },
  "anyOf": [{ "required": ["steps"] }, { "required": ["script"] }],
  "additionalProperties": true
}
