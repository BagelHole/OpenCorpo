{
  "appId": "ai.opencorpo.desktop",
  "productName": "OpenCorpo",
  "asar": true,
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../daemon/dist/index.mjs",
      "to": "daemon/index.mjs"
    },
    {
      "from": "../../config",
      "to": "templates/config"
    },
    {
      "from": "../../plugins",
      "to": "templates/plugins"
    },
    {
      "from": "../../userland",
      "to": "templates/userland"
    },
    {
      "from": ".runtime/bun",
      "to": "bun"
    },
    {
      "from": "../../OpenCorpo-logo.png",
      "to": "assets/OpenCorpo-logo.png"
    }
  ],
  "directories": {
    "output": "../../dist/desktop"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.business",
    "icon": "build/icon.icns",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "assets/entitlements.mac.plist",
    "entitlementsInherit": "assets/entitlements.mac.plist",
    "artifactName": "OpenCorpo-${version}-mac-${arch}.${ext}"
  },
  "win": {
    "target": ["nsis", "zip"],
    "icon": "assets/icon-256.png",
    "artifactName": "OpenCorpo-${version}-win-${arch}.${ext}"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Utility",
    "maintainer": "OpenCorpo Team <oss@opencorpo.ai>",
    "artifactName": "OpenCorpo-${version}-linux-${arch}.${ext}",
    "executableName": "opencorpo"
  },
  "deb": {
    "packageName": "opencorpo-desktop"
  }
}
