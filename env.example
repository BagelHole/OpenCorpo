# OpenCorpo environment variables
# Copy to .env and fill in as needed

# === AI Provider (required for chat) ===
# Set in Settings or during onboarding. Stored in daemon secrets.
# OPENAI_API_KEY=sk-...        # When using OpenAI provider
# ANTHROPIC_API_KEY=sk-ant-... # When using Anthropic provider
# VERCEL_AI_API_KEY=...        # When using Vercel AI Gateway (BYOK)

# === Gmail OAuth (optional) ===
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...

# === Daemon (usually auto-configured) ===
# OPENCORPO_PORT=3555
# OPENCORPO_DATA_DIR=./data
# OPENCORPO_CONFIG_DIR=./config
# OPENCORPO_PLUGINS_DIR=./plugins
